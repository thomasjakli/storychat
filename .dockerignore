# Deny by default: only explicitly named runtime sources reach the builder.
**
!Dockerfile
!.dockerignore
!app/
app/**
!app/server.mjs
!app/store.mjs
!app/provider.mjs
!prototype/
prototype/**
!prototype/auth.mjs
!prototype/cli.mjs
!prototype/errors.mjs
!prototype/handoff.mjs
!prototype/output.mjs
!prototype/provider.mjs
!prototype/runtime-lock.mjs
!prototype/stream.mjs
!prototype/vault.mjs
!public/
public/**
!public/index.html
!public/style.css
!public/app.js
!public/icon.svg
!public/manifest.webmanifest
!deploy/
deploy/**
!deploy/healthcheck.mjs
