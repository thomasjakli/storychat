# Optional template: copy to ignored .env and protect its filesystem permissions.
# Node does not read it automatically; use node --env-file=.env app/server.mjs.
STORYCHAT_PASSWORD=replace-with-a-unique-owner-password
STORYCHAT_PROVIDER=chatgpt
STORYCHAT_ACCOUNT_ID=select-the-local-cli-registration
STORYCHAT_MODEL=select-an-authorized-catalog-model
PORT=8787
# Default binding is loopback. Remote binding requires trusted HTTPS ingress.
# STORYCHAT_HOST=0.0.0.0
# STORYCHAT_ORIGIN=https://your-existing-private-hostname.example
